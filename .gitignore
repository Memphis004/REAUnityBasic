# ---------------------------------------------------------------------------
# ProjectSurvive .gitignore
# Unity + .NET + build artifacts. Keep secrets out of the repo.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Unity: build output and generated/local state (never commit)
# ---------------------------------------------------------------------------
my_clone/[Bb]uild/
my_clone/[Bb]uilds/
my_clone/[Ll]ogs/
my_clone/[Uu]ser[Ss]ettings/
my_clone/[Mm]emoryCaptures/
my_clone/[Rr]ecordings/

# Unity: auto-generated project files
my_clone/*.csproj
my_clone/*.unityproj
my_clone/*.sln
my_clone/*.suo
my_clone/*.user
my_clone/*.userprefs
my_clone/*.pidb
my_clone/*.booproj
my_clone/*.svd
my_clone/*.pdb
my_clone/*.mdb
my_clone/*.opendb
my_clone/*.VC.db
my_clone/.vsconfig
my_clone/.vs/

# Unity: crash/report files
my_clone/sysinfo.txt
my_clone/*.stackdump
my_clone/*.crashreport
my_clone/crashlytics-build.properties

# Unity: package manager local cache (UPM resolves from manifest.json)
my_clone/Library/
my_clone/Temp/
my_clone/Obj/
my_clone/Packages/packages-lock.json
my_clone/Packages/manifest.json.bak

# Unity: Addressables / StreamingAssets build leftovers (added by tooling, not by hand)
my_clone/Assets/StreamingAssets/aa.meta
my_clone/Assets/StreamingAssets/aa/

# Unity: the Test Framework writes a temporary scene next to the assets and does not
# always clean it up (init scene for PlayMode runs). Never part of the project.
my_clone/Assets/InitTestScene*.unity
my_clone/Assets/InitTestScene*.unity.meta

# Unity: known OS junk
.DS_Store
Thumbs.db
Desktop.ini

# ---------------------------------------------------------------------------
# .NET / dotnet
# ---------------------------------------------------------------------------
bin/
obj/
[Bb]in/
[Oo]bj/

# lib/Tests~ is outside Unity; its build output must never be committed
lib/Tests~/**/bin/
lib/Tests~/**/obj/

# Unity writes .meta files next to the sources of a local package (file:../../lib).
# They are engine-generated, machine-local identity for a folder of plain C# that
# nothing references by GUID -- my_clone's asmdefs reference lib by ASSEMBLY NAME
# -- and Stage 02 already decided .meta is not part of lib's generated output. The
# TRACKED .meta files that matter (the config .bytes in my_clone) are kept on
# purpose, see the note above.
lib/**/*.meta

# Test / coverage output
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coverlet.json
coverage/
.vs/
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json

# ---------------------------------------------------------------------------
# Node (Playwright and tooling)
# ---------------------------------------------------------------------------
node_modules/
tests/web/node_modules/
tests/web/playwright-report/
tests/web/test-results/
.npm/
npm-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------------
# artifacts/ : logs, reports, screenshots, traces (never commit, keep the folder)
# NOTE: use artifacts/* (not artifacts/) so that !artifacts/.gitkeep can
# re-include the placeholder - git cannot re-include a file under an excluded dir.
# ---------------------------------------------------------------------------
# artifacts/*
# !artifacts/.gitkeep

# ---------------------------------------------------------------------------
# Generated code that must be reproducible from data/ + proto/, not hand-edited
# (kept tracked so `verify-generated` can diff, but binaries are not)
# ---------------------------------------------------------------------------
lib/Runtime/Generated/**/*.bytes
my_clone/Assets/Main/Resources/Config/*.bytes
lib/Tests~/data/*.bytes

# ---------------------------------------------------------------------------
# Secrets / local environment
# ---------------------------------------------------------------------------
*.env
.env.*
!.env.example
*.lic
*.ulf
*.ulf.bak
secrets.json
appsettings.*.local.json

# ---------------------------------------------------------------------------
# Python bytecode (agent-tooling scripts under .agents/)
# ---------------------------------------------------------------------------
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Pinned external CLI toolchain (Luban, protoc): NOT committed.
# tools/setup-tools.ps1 downloads each archive by pinned URL + SHA-256 and
# extracts it here, so a fresh clone reproduces the exact same binaries.
# See tools/versions.lock.json -> vendoredTools.
# ---------------------------------------------------------------------------
tools/vendor/

# ---------------------------------------------------------------------------
# IDE
# ---------------------------------------------------------------------------
.idea/
.vscode/
!.vscode/settings.json.example
# Editor/OS backup files (e.g. Program.cs~) - but NOT lib/Tests~, which is a
# tracked dotnet project directory required by the GDD layout.
*.swp
*~
!lib/Tests~/


# Ignore everything inside game_copy, but keep the folder itself
game_copy/*
extracted/*
!game_copy/.gitkeep
!extracted/.gitkeep


# Ignore heavy data files inside extracted/ab_text, keep folder structure
extracted/ab_text/*
extracted/ilspy/*
!extracted/ab_text/.gitkeep
!extracted/ilspy/.gitkeep

# ---------------------------------------------------------------------------
# Local reference assets extracted from the game (read-only reference, not distributable)
# Added before any extraction; see notes/local_reference_demo.md
# ---------------------------------------------------------------------------
my_clone/Assets/_LocalReference/
my_clone/Assets/_LocalReference.meta
